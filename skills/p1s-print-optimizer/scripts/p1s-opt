#!/usr/bin/env bash
# Executa p1s_opt.py com um Python que tenha numpy e Pillow (para o render),
# em modo isolado (-I), já que os 3MF processados vêm de fontes não confiáveis.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
py=""
for c in /usr/bin/python3 python3; do
  if command -v "$c" >/dev/null && "$c" -I -c "import numpy, PIL" 2>/dev/null; then py="$c"; break; fi
done
[ -n "$py" ] || py="$(command -v python3)"
exec "$py" -I "$here/p1s_opt.py" "$@"
